#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-push hook: Run comprehensive checks before pushing
# This includes typecheck and tests

echo "🚀 Running pre-push checks..."

# 1. TypeScript type checking
echo "📝 Running TypeScript typecheck..."
if ! npm run typecheck; then
  echo "❌ TypeScript typecheck failed. Fix type errors before pushing."
  exit 1
fi

# 2. Run unit tests
echo "🧪 Running unit tests..."
if ! npm run test; then
  echo "❌ Unit tests failed. Fix failing tests before pushing."
  exit 1
fi

# Note: E2E tests are skipped in pre-push by default
# Run them manually with: npm run test:e2e

echo "✅ All pre-push checks passed!"

