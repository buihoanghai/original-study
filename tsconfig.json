{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "references": [
    { "path": "./apps/mindmap-web" },
    { "path": "./apps/mindmap-cms" },
    { "path": "./packages/domain" },
    { "path": "./packages/editor" },
    { "path": "./packages/flashcard" },
    { "path": "./packages/sync" },
    { "path": "./packages/testing" }
  ],
  "files": [],
  "include": []
}

