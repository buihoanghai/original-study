# Production Environment Variables
# Copy this file to .env.production and fill in your values

# ============================================
# MongoDB Configuration
# ============================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_HERE
MONGO_DATABASE=mindmap

# ============================================
# Payload CMS Configuration
# ============================================
# Generate a secure secret: openssl rand -base64 32
PAYLOAD_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS

# Your production domain (e.g., https://mindmap-api.yourdomain.com)
PAYLOAD_PUBLIC_SERVER_URL=https://mindmap-api.yourdomain.com

# ============================================
# Web App Configuration
# ============================================
# Should match PAYLOAD_PUBLIC_SERVER_URL
NEXT_PUBLIC_CMS_URL=https://mindmap-api.yourdomain.com

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production

# ============================================
# Optional: Debug Settings (disable in production)
# ============================================
DEBUG_TRACE=0
NEXT_PUBLIC_DEBUG_TRACE=0

