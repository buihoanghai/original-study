{
  "name": "mindmap-learning-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "dev": "npm run dev:web & npm run dev:cms",
    "dev:web": "npm run dev --workspace=apps/mindmap-web",
    "dev:cms": "npm run dev --workspace=apps/mindmap-cms",
    "dev:db": "cd apps/mindmap-cms && docker compose up -d mongo",
    "dev:all": "npm run dev:db && npm run dev",
    "stop:db": "cd apps/mindmap-cms && docker compose stop mongo",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=apps/mindmap-web",
    "build:cms": "npm run build --workspace=apps/mindmap-cms",
    "start": "npm run start --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "typecheck:watch": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.config.prod.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/.next apps/*/dist packages/*/dist",
    "prepare": "husky",
    "doctor": "node scripts/doctor.js",
    "triage": "node scripts/triage.js"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "latest",
    "react-dom": "latest",
    "reactflow": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "patch-package": "^8.0.1",
    "prettier": "latest",
    "typescript": "latest",
    "vitest": "^4.0.18"
  }
}
